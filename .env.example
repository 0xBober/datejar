# Environment variables for DateJar.
# Copy this file to .env and adjust values.

# Runtime environment: "dev" or "prod".
# In "prod" the API docs (/docs) are disabled and SECRET_KEY must be changed.
ENVIRONMENT=dev

# Database URL, e.g. "sqlite:///./datejar.db" or "sqlite:////var/lib/datejar/datejar.db"
DATABASE_URL=sqlite:///./datejar.db

# Secret Key, run 'uv run python -c "import secrets; print(secrets.token_urlsafe(32))"' to generate a new key. This key is used to sign cookies and other secrets. Change this in production!
SECRET_KEY=change_me